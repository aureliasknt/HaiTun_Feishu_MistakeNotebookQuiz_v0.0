# Copy to `.env` in the repo root, then fill in real values from the Feishu
# console. `.env` is gitignored: never commit real credentials.
#
# Load into your shell before scripts/dev-feishu.ps1:
#   PowerShell: Get-Content .env | ? { $_ -match '^\s*[^#]' } | % { $kv = $_ -split '=',2; [Environment]::SetEnvironmentVariable($kv[0].Trim(), $kv[1].Trim()) }
#   bash:       set -a; source .env; set +a

# 飞书自建应用凭证 (开发者后台 → 凭证与基础信息)。
# Gateway 与飞书 channel 两个进程都要读到, 缺一个就起不来。
PSI_FEISHU_APP_ID=cli_your_app_id_here
PSI_FEISHU_APP_SECRET=your_app_secret_here

# Gateway also serves the OAuth relay. The Feishu console redirect URL must be
# exactly {PSI_OAUTH_CALLBACK_BASE}/oauth/callback
PSI_OAUTH_CALLBACK_BASE=http://127.0.0.1:8765

# Keep Gateway and the Feishu channel on the same AppData root, or card
# callbacks fail closed (see src/psi_agent/channel/AGENTS.md).
# Use forward slashes: bash `source` strips backslashes, which silently
# produced C:\UsersaurelAppDataLocalHaitun and broke card-callback lookup.
PSI_APPDATA=C:/Users/<you>/AppData/Local/Haitun

# Supervisor child-Session model binding. Discovery order is
# PSI_GATEWAY_URL -> .psi/gateway.url -> 127.0.0.1:62720 / :8080. Our listen
# address is none of those defaults, so without this the probe times out and
# every turn records source=unavailable (see scripts/dev-feishu.ps1).
PSI_GATEWAY_URL=http://127.0.0.1:8765

# AI id the Feishu bot routes to (must exist in GET /ais).
# Must match $AiId in scripts/dev-feishu.ps1. A random per-session id goes
# stale whenever the AI is recreated, leaving the Feishu session bound to a
# dead AI (symptom: "Cannot connect to host localhost:80").
PSI_FEISHU_AI_ID=feishu-default

# deepseek-v4-flash key. The model name is company-proxy-only naming, so this
# pairs with base_url=https://misakamikoto.genuineknowledge.cn, not the public
# api.deepseek.com.
DEEPSEEK_API_KEY=your_deepseek_key_here
